{
  "name": "@tkottke/hateos-url-manager",
  "version": "1.3.0",
  "description": "Browser and Express JS Utility for creating and maintaining a HATEOS API",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/mjs/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "rm -fr dist/* && node esbuild.config.js && npm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/mjs && node scripts/fix-dts-extensions.js",
    "test": "export TSX_TSCONFIG_PATH=./tsconfig.test.json && mocha"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^25.0.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "esbuild": "0.28.2",
    "esbuild-node-externals": "2.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "express": "^4.18.2",
    "mocha": "12.0.3",
    "tsx": "4.23.15",
    "typescript": "^5.3.3"
  },
  "main": "esbuild.config.js",
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkottke90/hateos-url-manager.git"
  },
  "bugs": {
    "url": "https://github.com/tkottke90/hateos-url-manager/issues"
  },
  "homepage": "https://github.com/tkottke90/hateos-url-manager#readme"
}
